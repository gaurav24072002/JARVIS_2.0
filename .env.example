# ============================================================
# JARVIS — environment configuration
# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env
# `.env` is git-ignored — never commit your real one.
# ============================================================

# --- Local Ollama (no cloud API keys required) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nemotron-3.5-lightning:latest
OLLAMA_BRAIN_MODEL=nemotron-3.5-lightning:latest
# Vision needs a vision-capable model (pull with: ollama pull llava):
OLLAMA_VISION_MODEL=llava
OLLAMA_REQUEST_TIMEOUT=120

# --- Web search (optional, Tavily) ---
# Leave empty to disable web search; everything else works without it.
TAVILY_API_KEY=

# --- HTTPS (on by default) ---
# Required for the microphone to work when opened via a LAN IP.
# Self-signed cert is auto-generated in ./certs. Set to 0 for plain HTTP
# (localhost only — the mic will NOT work from another device then).
JARVIS_HTTPS=1

# --- Voice (edge-tts) ---
# Two en-GB male voices exist on most edge-tts builds:
#   en-GB-RyanNeural    — calm, closest to JARVIS (default)
#   en-GB-ThomasNeural  — brighter / younger
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=+10%
TTS_PITCH=-6Hz

# --- Persona ---
ASSISTANT_NAME=JARVIS
JARVIS_USER_TITLE=Sir
JARVIS_OWNER_NAME=Sir
